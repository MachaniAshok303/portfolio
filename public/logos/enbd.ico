    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
        function copyRefId() {
            const refId = document.getElementById('refId').textContent;
            navigator.clipboard.writeText(refId).then(() => {
                const btn = document.querySelector('.ref-copy');
                btn.classList.add('copied');
                setTimeout(() => btn.classList.remove('copied'), 2000);
            });
        }
        // Dropdown menu functionality
        document.addEventListener('DOMContentLoaded', function () {
            const dropdownContainer = document.querySelector('.container > div');
            const dropdownButton = document.querySelector('.online-banking-btn');
            const dropdownMenu = document.querySelector('.dropdown-menu__list');

            // Detect if device is touch-capable
            function isTouchDevice() {
                return (('ontouchstart' in window) ||
                    (navigator.maxTouchPoints > 0) ||
                    (navigator.msMaxTouchPoints > 0));
            }

            // Add touch class to body if touch device
            if (isTouchDevice()) {
                document.body.classList.add('touch-device');
            }

            // Toggle dropdown on button click (only for touch devices)
            dropdownButton.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                // Only toggle (close on second click) for touch devices
                if (isTouchDevice()) {
                    dropdownContainer.classList.toggle('dropdown-active');
                } else {
                    // For desktop, just open (hover handles closing)
                    dropdownContainer.classList.add('dropdown-active');
                }
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function (e) {
                if (!dropdownContainer.contains(e.target)) {
                    dropdownContainer.classList.remove('dropdown-active');
                }
            });

            // Close dropdown when clicking a link inside the menu
            const dropdownLinks = dropdownMenu.querySelectorAll('a');
            dropdownLinks.forEach(function (link) {
                link.addEventListener('click', function () {
                    dropdownContainer.classList.remove('dropdown-active');
                });
            });
        });
    </script>

</body>

</html>